{
  "name": "minute-mysteries-shorts",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "^4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "ffmpeg-static": "^5.3.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render MinuteMysteriesShort out/minute-mysteries-roadster.mp4",
    "render:playbook": "remotion render AIGrowthPlaybookShort out/ai-growth-playbook.mp4",
    "render:f1": "remotion render WhyF1DriversLoseNinePoundsShort out/why-f1-drivers-lose-9-pounds.mp4",
    "render:roadster-upside-down": "remotion render TeslaRoadsterUpsideDown out/tesla-roadster-upside-down.mp4",
    "render:pisa": "remotion render LeaningTowerPisaShort out/leaning-tower-pisa.mp4",
    "render:fast": "remotion render MinuteMysteriesShort out/preview-5s.mp4 --frames=0-180",
    "sfx:generate": "node scripts/align_and_master_audio.js",
    "transcribe": "~/.local/edit-tools/.venv/bin/python scripts/transcribe.py",
    "listen": "~/.local/edit-tools/.venv/bin/python scripts/listen.py",
    "reel:create": "node scripts/create_reel_from_audio.js",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
